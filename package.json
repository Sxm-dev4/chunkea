{
  "name": "chunkea-web",
  "version": "1.0.0",
  "description": "Landing de Chunkea: forros chunky personalizables con armador 3D y pedido por WhatsApp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "images": "node scripts/generate-images.mjs",
    "renders:process": "node scripts/process-cases.mjs",
    "models:process": "node scripts/process-cases-3d.mjs",
    "chunkis:extract": "node scripts/extract-chunkis.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "lottie-web": "^5.13.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
